[Unit]
Description=Discord Issue Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=yaywang
WorkingDirectory=/home/yaywang/discord-dashboard/output/discord-issue-dashboard
EnvironmentFile=/home/yaywang/discord-dashboard/output/discord-issue-dashboard/.env
ExecStart=/home/yaywang/anaconda3/bin/streamlit run dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
